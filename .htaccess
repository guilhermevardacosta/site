RewriteEngine On

# 1. Se alguém acessar uma página digitando .html, redireciona para a URL limpa (301 permanente)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Faz o servidor ler internamente o arquivo .html correspondente sem mostrar a extensão
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]